.terraform/
# Provider lock file: CI generates it fresh each plan and hands it to the
# apply job as an artifact (see .github/workflows/cloudflare-root.yml); it
# is never meant to be committed.
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
plan.bin
backend.hcl
crash.log
.export/
__pycache__/
*.pyc
.imports.tf.skip
# Local backend: state files and the generated backend override
.state/
backend_override.tf
# Plan output (may contain record contents; never commit)
plan.json
plan.log
plan-summary.md
.plan-input.sha256
.plan-revision
deviation.bin
deviation.json
deviation.log
.init.log
provider_override.tf
# Generated by scripts/compliance_audit.py
.audit/

# Local secrets: never commit, whatever shape they take
.env
.env.*
!.env.example

# OS/editor cruft
.DS_Store
Thumbs.db
desktop.ini
