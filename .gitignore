.terraform/
# NOTE: .terraform.lock.hcl is deliberately NOT ignored. It pins the exact
# Cloudflare provider build, with checksums, for every root. Leaving it out
# of Git meant `version = "~> 5.26"` let each plan resolve a different 5.x
# build with nothing reviewed and nothing to compare against. CI still hands
# it to the apply job as an artifact (see cloudflare-root.yml) so plan and
# apply use the same provider, and cf.py folds it into the plan fingerprint.
# Regenerate with:
#   terraform -chdir=<root> providers lock -platform=linux_amd64 -platform=windows_amd64
*.tfstate
*.tfstate.*
*.tfplan
plan.bin
backend.hcl
crash.log
.export/
__pycache__/
*.pyc
.imports.tf.skip
# Local backend: state files and the generated backend override
.state/
backend_override.tf
# Plan output (may contain record contents; never commit)
plan.json
plan.log
plan-summary.md
.plan-input.sha256
.plan-revision
deviation.bin
deviation.json
deviation.log
.init.log
.exported-files.json
provider_override.tf

# Local secrets: never commit, whatever shape they take
.env
.env.*
!.env.example

# OS/editor cruft
.DS_Store
Thumbs.db
desktop.ini

# Local Claude and Codex configuration and instructions
.claude/
.claude.json
.codex/
CLAUDE.md
CLAUDE.local.md
AGENTS.md
AGENTS.override.md

# graphify output
graphify-out

# Local operational snapshots and recovery artifacts
.inventory.json
.review.json
.provider-schema.json
.preflight*
.reconciliation.json
.reconcile*
.refresh*
.verify*
.operation-lock

.inventory-before.json
inventory-report.md
plan-details.md

apply.log
deployment-outcome.json
.outcome*
